<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up saved words, history and settings; skip caches and offline copies (they can be re-downloaded). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="file" path="offline/" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
