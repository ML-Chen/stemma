{"en":[{"partOfSpeech":"Adjective","language":"English","definitions":[{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/resemble\" title=\"resemble\">Resembling</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/characteristic\" title=\"characteristic\">characteristic</a> of the <a rel=\"mw:WikiLink\" href=\"/wiki/Spanish\" title=\"Spanish\">Spanish</a> <a rel=\"mw:WikiLink\" href=\"/wiki/chivalric\" title=\"chivalric\">chivalric</a> hero <a rel=\"mw:WikiLink/Interwiki\" href=\"https://en.wikipedia.org/wiki/Don%20Quixote\" title=\"w:Don Quixote\" about=\"#mwt15\" typeof=\"mw:Transclusion\" class=\"extiw\">Don Quixote</a>; possessed with or resulting from the <a rel=\"mw:WikiLink\" href=\"/wiki/desire\" title=\"desire\">desire</a> to do <a rel=\"mw:WikiLink\" href=\"/wiki/noble\" title=\"noble\">noble</a> and <a rel=\"mw:WikiLink\" href=\"/wiki/romantic\" title=\"romantic\">romantic</a> <a rel=\"mw:WikiLink\" href=\"/wiki/deed\" title=\"deed\">deeds</a>, without thought of <a rel=\"mw:WikiLink\" href=\"/wiki/realism\" title=\"realism\">realism</a> and <a rel=\"mw:WikiLink\" href=\"/wiki/practicality\" title=\"practicality\">practicality</a>."},{"definition":"Overly <a rel=\"mw:WikiLink\" href=\"/wiki/optimistic\" title=\"optimistic\">optimistic</a> and <a rel=\"mw:WikiLink\" href=\"/wiki/moralistic\" title=\"moralistic\">moralistic</a>."},{"definition":"Exceedingly <a rel=\"mw:WikiLink\" href=\"/wiki/idealistic\" title=\"idealistic\">idealistic</a>."}]},{"partOfSpeech":"Noun","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt72\" typeof=\"mw:Transclusion\"></span> A quixotic <a rel=\"mw:WikiLink\" href=\"/wiki/person\" title=\"person\">person</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/sentiment\" title=\"sentiment\">sentiment</a>."}]}]}